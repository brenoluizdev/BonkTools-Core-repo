BONK_USERNAME=
BONK_PASSWORD=

# Caminho do arquivo de cache local (compartilhado com apps/bonk-room via
# BONK_BLOB_CACHE_PATH). Default: apps/blob-seeder/map-blob-cache.json.
# Aponte pro MESMO arquivo usado pelo bonk-room pra que o bot leve reutilize
# o que o seeder capturar.
# BONK_BLOB_CACHE_PATH=../bonk-room/map-blob-cache.json

# true (default) = navegador headless. Use false só pra depurar localmente
# (ver o browser real clicando na tela).
# BLOB_SEEDER_HEADLESS=true
